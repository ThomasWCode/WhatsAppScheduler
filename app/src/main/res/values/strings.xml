    <string name="setup_notifications_why">For the countdown before a send, and for telling you when one couldn\'t go.</string>
    <string name="setup_fullscreen_title">Full-screen notifications allowed</string>
    <string name="setup_fullscreen_why">The other way the app wakes a locked phone\'s screen, if the first doesn\'t work.</string>
    <string name="setup_battery_title">Battery: unrestricted</string>
    <string name="setup_battery_why">Stops Android and One UI from deferring the alarm or killing the service.</string>
    <string name="setup_samsung_title">Samsung: add to \"Never sleeping apps\"</string>
    <string name="setup_samsung_why">Settings → Battery → Background usage limits → Never sleeping apps → add WhatsApp Scheduler. Also keep WhatsApp out of \"Deep sleeping apps\".</string>
    <string name="setup_pin_title">Lock-screen PIN stored</string>
    <string name="setup_pin_why">Your lock must be a PIN or password (pattern is not supported). Store it under Settings. If One UI\'s Auto factory reset is on, keep the stored PIN up to date: the app stops after one rejected unlock, but a wrong PIN still costs attempts.</string>
    <string name="setup_pin_why_no_lock">No secure lock detected: nothing to store.</string>
    <string name="setup_walock_title">WhatsApp app lock off</string>
    <string name="setup_walock_why">WhatsApp → Settings → Privacy → App lock must be off. Chat Lock on individual chats is fine.</string>
    <string name="setup_accessibility_enabled_title">Accessibility service enabled</string>
    <string name="setup_accessibility_why">Lets the app tap Send, type the PIN on the lock screen and navigate WhatsApp. Idle otherwise.</string>
